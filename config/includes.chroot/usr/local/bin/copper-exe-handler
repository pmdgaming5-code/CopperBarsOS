#!/bin/sh
set -eu

EXE="${1:-}"
[ -n "$EXE" ] || exit 2
if [ ! -f "$EXE" ]; then
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --text="Windows EXE dosyası bulunamadı."
  fi
  exit 1
fi

NAME=$(basename "$EXE" .exe)
SAFE=$(printf '%s' "$NAME" | tr -c '[:alnum:]._-' '_')
PREFIX="$HOME/.local/share/copperbars/wine/$SAFE"
mkdir -p "$PREFIX"

export WINEPREFIX="$PREFIX"
export WINEARCH=win64

if ! command -v wine >/dev/null 2>&1; then
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --text="Wine kurulu değil. CopperBars Store'dan Windows Uyumluluğu paketini kur."
  fi
  exit 1
fi

if [ ! -d "$PREFIX/drive_c" ]; then
  if ! wineboot -u >/dev/null 2>&1; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --text="Wine ortamı oluşturulamadı. CopperBars Windows Merkezi'nden tanılama çalıştır."
    fi
    exit 1
  fi
fi

exec wine "$EXE"
