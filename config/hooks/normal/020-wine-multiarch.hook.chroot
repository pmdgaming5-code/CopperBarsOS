#!/bin/sh
set -eu

# Foreign-architecture packages are declared in the package list so
# live-build enables i386 before installing Wine components.
if ! dpkg --print-foreign-architectures | grep -qx 'i386'; then
  echo 'CopperBarsOS: i386 foreign architecture was not enabled.' >&2
  exit 1
fi

for package in wine32:i386 dxvk-wine32:i386; do
  dpkg-query -W -f='${Status}\n' "$package" 2>/dev/null | grep -q 'install ok installed' || {
    echo "CopperBarsOS: required package is missing: $package" >&2
    exit 1
  }
done
