[Unit]
Description=CopperBarsOS Local AI Assistant
After=network.target
Wants=network.target

[Service]
Type=simple
User=copper
Group=copper
WorkingDirectory=/opt/copperbars
ExecStart=/usr/bin/python3 /opt/copperbars/copper_ai.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/copperbars/models /var/lib/copperbars
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=COPPER_MODEL_DIR=/opt/copperbars/models
Environment=COPPER_PORT=8765

[Install]
WantedBy=multi-user.target
