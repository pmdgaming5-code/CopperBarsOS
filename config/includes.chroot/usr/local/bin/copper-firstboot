#!/bin/sh
set -eu

STATE=/var/lib/copperbars/firstboot-complete
mkdir -p "$(dirname "$STATE")"

systemctl enable copper-ai.service || true
systemctl start copper-ai.service || true

# A small marker allows the XFCE autostart helper to open Copper exactly once.
# It is intentionally not created here; the GUI helper creates it after the
# first-start window has actually been shown.
printf '%s\n' "CopperBarsOS first boot prepared at $(date -u +%FT%TZ)" > /var/lib/copperbars/firstboot-status
