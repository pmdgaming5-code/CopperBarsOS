#!/bin/sh
set -eu

# Wine 32-bit support is installed only after the normal package list has
# completed, because i386 must be enabled before foreign-architecture packages
# can be resolved.
if ! dpkg --print-foreign-architectures | grep -qx 'i386'; then
  dpkg --add-architecture i386
fi

apt-get update
apt-get install -y --no-install-recommends wine32:i386 dxvk-wine32:i386
rm -rf /var/lib/apt/lists/*

# Fail the image build if multiarch support was not actually installed.
dpkg-query -W -f='${Status}\n' wine32:i386 | grep -q 'install ok installed'
dpkg-query -W -f='${Status}\n' dxvk-wine32:i386 | grep -q 'install ok installed'
